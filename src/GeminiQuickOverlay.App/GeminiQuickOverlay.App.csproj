<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\AIHelper.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GeminiQuickOverlay</AssemblyName>
    <RootNamespace>GeminiQuickOverlay.App</RootNamespace>
    <Version>1.4.1</Version>
    <Authors>PhucDaizz</Authors>
    <Company>PhucDaizz</Company>
    <Product>Gemini Quick Overlay</Product>
    <AssemblyTitle>Gemini Quick Overlay</AssemblyTitle>
    <Description>Quick Gemini answers in a transparent overlay, without switching tabs.</Description>
    <Copyright>Copyright (c) 2026 PhucDaizz</Copyright>
    <RepositoryUrl>https://github.com/PhucDaizz/gemini_quick_overlay</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeminiQuickOverlay.Core\GeminiQuickOverlay.Core.csproj" />
    <Resource Include="..\..\AIHelper.ico" Link="Assets\AIHelper.ico" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
