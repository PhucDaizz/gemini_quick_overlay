<Window x:Class="GeminiQuickOverlay.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hotkeys="clr-namespace:GeminiQuickOverlay.App.Hotkeys"
        xmlns:local="clr-namespace:GeminiQuickOverlay.App.Settings"
        Title="Cài đặt - Gemini Quick Overlay"
        Width="780"
        Height="720"
        MinWidth="680"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Cài đặt" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="Thay đổi được áp dụng ngay sau khi bấm Lưu." />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Chung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Prompt" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Khi gửi văn bản" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PromptTextTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,14" />
                                <TextBlock Text="Khi gửi ảnh" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PromptImageTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Thời gian chờ" Style="{StaticResource CardTitle}" />
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="Hiện đáp án (giây)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="DisplaySecondsBox" Style="{StaticResource NumberBox}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Chờ phản hồi (giây)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ResponseTimeoutBox" Style="{StaticResource NumberBox}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Chờ trang Gemini (giây)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PageWaitBox" Style="{StaticResource NumberBox}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Chờ dán ảnh (giây)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ImageWaitBox" Style="{StaticResource NumberBox}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Cạnh ảnh tối đa (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ImageMaxSizeBox" Style="{StaticResource NumberBox}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Văn bản ổn định (ms)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SettleMsBox" Style="{StaticResource NumberBox}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Hành vi" Style="{StaticResource CardTitle}" />
                                <CheckBox x:Name="ShowPendingCheck" Content="Hiện &quot;...&quot; để xác nhận đã nhận câu hỏi" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckUpdatesCheck" Content="Tự kiểm tra bản mới trên GitHub mỗi ngày" Margin="0,0,0,8" />
                                <CheckBox x:Name="AutoLaunchCheck" Content="Tự bật Chrome nếu cổng debug chưa mở" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Giao diện">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Chữ" Style="{StaticResource CardTitle}" />
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="Màu chữ" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBox x:Name="TextColorBox" Style="{StaticResource NumberBox}" Width="96" Margin="0,0,6,0" TextChanged="ColorTextChanged" />
                                            <Button x:Name="TextColorButton" Width="32" Height="32" Padding="4" ToolTip="Chọn màu" Click="PickTextColor_Click">
                                                <Border x:Name="TextColorSwatch" Width="20" Height="20" CornerRadius="3" Background="Black" BorderBrush="#66808080" BorderThickness="1" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Cỡ chữ" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="FontSizeBox" Style="{StaticResource NumberBox}" TextChanged="AppearanceChanged" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Độ rộng tối đa (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="WrapLengthBox" Style="{StaticResource NumberBox}" TextChanged="AppearanceChanged" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Màu nền cũ (giữ tương thích với config.json)" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="BackgroundColorBox" Style="{StaticResource NumberBox}" Width="96" Margin="0,0,6,0" TextChanged="ColorTextChanged" />
                                    <Button x:Name="BackgroundColorButton" Width="32" Height="32" Padding="4" ToolTip="Chọn màu" Click="PickBackgroundColor_Click">
                                        <Border x:Name="BackgroundColorSwatch" Width="20" Height="20" CornerRadius="3" Background="#abcdef" BorderBrush="#66808080" BorderThickness="1" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Vị trí và độ mờ" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Khung viền xanh trên màn hình là overlay xem trước. Kéo nó đến chỗ bạn muốn, các ô bên dưới tự cập nhật." />
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="Cách trái (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="LeftOffsetBox" Style="{StaticResource NumberBox}" TextChanged="OffsetsTyped" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Cách đáy (px)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BottomOffsetBox" Style="{StaticResource NumberBox}" TextChanged="OffsetsTyped" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Button Content="Đặt lại vị trí" MinWidth="120" Margin="0,0,0,14" Click="ResetPosition_Click" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Độ mờ" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.05" ValueChanged="OpacityChanged" />
                                    <TextBlock x:Name="OpacityLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Phím tắt">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Phím tắt toàn cục" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                           Text="Bấm vào ô rồi nhấn tổ hợp phím. Ví dụ: F2, esc, ctrl+shift+g." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Gửi (văn bản / ảnh)" VerticalAlignment="Center" />
                                    <hotkeys:HotkeyTextBox x:Name="HotkeySendBox" Grid.Column="1" Margin="0,4" />

                                    <TextBlock Grid.Row="1" Text="Xem lại đáp án" VerticalAlignment="Center" />
                                    <hotkeys:HotkeyTextBox x:Name="HotkeyReplayBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                                    <TextBlock Grid.Row="2" Text="Copy đáp án" VerticalAlignment="Center" />
                                    <hotkeys:HotkeyTextBox x:Name="HotkeyCopyBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                                    <TextBlock Grid.Row="3" Text="Ẩn overlay" VerticalAlignment="Center" />
                                    <hotkeys:HotkeyTextBox x:Name="HotkeyHideBox" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                                </Grid>
                                <Button x:Name="ResetHotkeysButton" Content="Khôi phục phím mặc định" HorizontalAlignment="Left" MinWidth="170" Margin="0,18,0,0" Click="ResetHotkeys_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Gemini &amp; Chrome">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Chrome" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Thư mục profile" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ProfileDirBox" />
                                    <Button Grid.Column="1" Content="Chọn..." MinWidth="84" Margin="8,0,0,0" Click="BrowseProfile_Click" />
                                </Grid>

                                <TextBlock Text="Cổng debug" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DebugPortBox" Style="{StaticResource NumberBox}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Nếu cổng bị VS Code hoặc ứng dụng Electron chiếm, hãy đổi sang cổng khác (ví dụ 9223)." />
                                <TextBlock x:Name="DetectedChromeText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Kiểm tra" Style="{StaticResource CardTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ShowChromeButton" Content="Mở Chrome" MinWidth="120" Click="ShowChrome_Click" />
                                    <Button x:Name="TestButton" Content="Test Gemini" MinWidth="120" Margin="8,0,0,0" Click="Test_Click" />
                                </StackPanel>
                                <TextBlock x:Name="TestStatusText" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Nâng cao">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tệp và cập nhật" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                           Text="Selectors DOM của Gemini chỉ sửa trong config.json khi Google đổi giao diện." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Mở config.json" MinWidth="130" Click="OpenConfig_Click" />
                                    <Button Content="Mở log" MinWidth="130" Margin="8,0,0,0" Click="OpenLog_Click" />
                                    <Button x:Name="CheckUpdateButton" Content="Kiểm tra cập nhật" MinWidth="150" Margin="8,0,0,0" Click="CheckUpdate_Click" />
                                </StackPanel>
                                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Khôi phục" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                           Text="Đưa mọi tùy chọn về mặc định (chỉ có hiệu lực sau khi bấm Lưu)." />
                                <Button Content="Khôi phục toàn bộ mặc định" HorizontalAlignment="Left" MinWidth="210" Click="ResetAll_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Lưu" MinWidth="96" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" />
        </StackPanel>

        <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border x:Name="ColorPopupBorder" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#55808080" Margin="0,4,0,0">
                <local:ColorPickerPanel x:Name="ColorPanel" />
            </Border>
        </Popup>
    </Grid>
</Window>
