<Window x:Class="GeminiQuickOverlay.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hotkeys="clr-namespace:GeminiQuickOverlay.App.Hotkeys"
        Title="Cài đặt - AIHelper"
        Width="760"
        Height="700"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Chung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Prompt khi gửi văn bản" FontWeight="SemiBold" />
                        <TextBox x:Name="PromptTextTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64" Margin="0,4,0,12" />

                        <TextBlock Text="Prompt khi gửi ảnh" FontWeight="SemiBold" />
                        <TextBox x:Name="PromptImageTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64" Margin="0,4,0,12" />

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Thời gian hiện đáp án (giây)" />
                                <TextBox x:Name="DisplaySecondsBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Chờ phản hồi tối đa (giây)" />
                                <TextBox x:Name="ResponseTimeoutBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Chờ trang Gemini sẵn sàng (giây)" />
                                <TextBox x:Name="PageWaitBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Chờ ảnh dán vào ô nhập (giây)" />
                                <TextBox x:Name="ImageWaitBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Cạnh lớn nhất của ảnh (px)" />
                                <TextBox x:Name="ImageMaxSizeBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Chờ văn bản ổn định (ms)" />
                                <TextBox x:Name="SettleMsBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <CheckBox x:Name="ShowPendingCheck" Content="Hiện &quot;...&quot; khoảng 2 giây để xác nhận đã nhận câu hỏi" Margin="0,8,0,4" />
                        <CheckBox x:Name="CheckUpdatesCheck" Content="Tự kiểm tra bản mới trên GitHub mỗi ngày" Margin="0,4" />
                        <CheckBox x:Name="AutoLaunchCheck" Content="Tự bật Chrome nếu cổng debug chưa mở" Margin="0,4" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Giao diện">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Màu chữ (tên hoặc #hex)" />
                                <TextBox x:Name="TextColorBox" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0" TextChanged="AppearanceChanged" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Màu nền cũ (giữ tương thích)" />
                                <TextBox x:Name="BackgroundColorBox" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Cỡ chữ" />
                                <TextBox x:Name="FontSizeBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" TextChanged="AppearanceChanged" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Độ rộng tối đa (wrap_length)" />
                                <TextBox x:Name="WrapLengthBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" TextChanged="AppearanceChanged" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Cách trái (px)" />
                                <TextBox x:Name="LeftOffsetBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Cách đáy (px)" />
                                <TextBox x:Name="BottomOffsetBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Độ mờ" Margin="0,8,0,0" />
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.05" ValueChanged="OpacityChanged" />
                            <TextBlock x:Name="OpacityLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Xem trước" FontWeight="SemiBold" />
                        <Border x:Name="PreviewBorder" Background="#333333" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <TextBlock x:Name="PreviewText"
                                       Text="Đây là đáp án xem trước. Chữ sẽ hiện trên nền trong suốt khi chạy."
                                       TextWrapping="Wrap"
                                       Foreground="Black"
                                       FontFamily="Arial"
                                       FontWeight="Bold"
                                       MaxWidth="700" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Phím tắt">
                <StackPanel Margin="12">
                    <TextBlock Text="Bấm vào ô rồi nhấn tổ hợp phím. Ví dụ: F2, esc, ctrl+shift+g." TextWrapping="Wrap" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Gửi (text/ảnh)" VerticalAlignment="Center" />
                        <hotkeys:HotkeyTextBox x:Name="HotkeySendBox" Grid.Column="1" Margin="0,4" />

                        <TextBlock Grid.Row="1" Text="Xem lại đáp án" VerticalAlignment="Center" />
                        <hotkeys:HotkeyTextBox x:Name="HotkeyReplayBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                        <TextBlock Grid.Row="2" Text="Copy đáp án" VerticalAlignment="Center" />
                        <hotkeys:HotkeyTextBox x:Name="HotkeyCopyBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                        <TextBlock Grid.Row="3" Text="Ẩn overlay" VerticalAlignment="Center" />
                        <hotkeys:HotkeyTextBox x:Name="HotkeyHideBox" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                    </Grid>

                    <Button x:Name="ResetHotkeysButton" Content="Khôi phục phím tắt mặc định" HorizontalAlignment="Left" Margin="0,20,0,0" Click="ResetHotkeys_Click" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Gemini &amp; Chrome">
                <StackPanel Margin="12">
                    <TextBlock Text="Thư mục profile Chrome" FontWeight="SemiBold" />
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileDirBox" />
                        <Button Grid.Column="1" Content="Chọn..." Padding="12,2" Margin="8,0,0,0" Click="BrowseProfile_Click" />
                    </Grid>

                    <TextBlock Text="Cổng debug" />
                    <TextBox x:Name="DebugPortBox" Width="140" HorizontalAlignment="Left" Margin="0,4,0,12" />

                    <TextBlock x:Name="DetectedChromeText" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ShowChromeButton" Content="Mở Chrome" Padding="14,4" Click="ShowChrome_Click" />
                        <Button x:Name="TestButton" Content="Test Gemini" Padding="14,4" Margin="8,0,0,0" Click="Test_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TestStatusText" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="Nếu cổng debug bị VS Code/Electron chiếm, hãy đổi cổng." TextWrapping="Wrap" Foreground="#666666" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Nâng cao">
                <StackPanel Margin="12">
                    <TextBlock Text="Selectors DOM của Gemini chỉ sửa trong config.json khi Google đổi giao diện." TextWrapping="Wrap" Margin="0,0,0,16" />
                    <Button Content="Mở config.json" HorizontalAlignment="Left" Padding="14,4" Click="OpenConfig_Click" />
                    <Button Content="Mở log" HorizontalAlignment="Left" Padding="14,4" Margin="0,8,0,0" Click="OpenLog_Click" />
                    <Button x:Name="CheckUpdateButton" Content="Kiểm tra cập nhật" HorizontalAlignment="Left" Padding="14,4" Margin="0,8,0,0" Click="CheckUpdate_Click" />
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <Button Content="Khôi phục toàn bộ mặc định" HorizontalAlignment="Left" Padding="14,4" Margin="0,24,0,0" Click="ResetAll_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Width="90" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Lưu" Width="90" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
