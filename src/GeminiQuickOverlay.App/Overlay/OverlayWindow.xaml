<Window x:Class="GeminiQuickOverlay.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIHelper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Opacity="0.5"
        ThemeMode="None">
    <Border x:Name="MessageBorder" Padding="10,8" Background="Transparent">
        <TextBlock x:Name="MessageText"
                   Text=""
                   FontFamily="Segoe UI"
                   FontWeight="SemiBold"
                   Foreground="Black"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   MaxWidth="800"
                   TextOptions.TextFormattingMode="Display"
                   TextOptions.TextRenderingMode="ClearType">
            <!-- Soft light halo keeps dark text legible over dark content without a solid box. -->
            <TextBlock.Effect>
                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="6" Opacity="0.85" />
            </TextBlock.Effect>
        </TextBlock>
    </Border>
</Window>
