<Window x:Class="GeminiQuickOverlay.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIHelper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Opacity="0.5">
    <Border x:Name="MessageBorder" Padding="8" Background="Transparent">
        <TextBlock x:Name="MessageText"
                   Text=""
                   FontFamily="Arial"
                   FontWeight="Bold"
                   Foreground="Black"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   MaxWidth="800" />
    </Border>
</Window>
